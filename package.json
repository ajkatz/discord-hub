{
  "name": "discord-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provision per-project sub-communities (role, category, channels, forums, webhook, onboarding entry) in one Discord server.",
  "bin": {
    "discord-hub": "./bin/discord-hub.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@discordjs/rest": "^2.4.0",
    "discord-api-types": "^0.38.0",
    "discord.js": "^14.27.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
